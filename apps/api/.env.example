# Copy to .dev.vars for local development. Wrangler loads it for the API worker.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
RESEND_API_KEY=re_replace_with_your_resend_key
# Use an address on a domain verified in Resend.
RESEND_FROM_EMAIL=Router <auth@router.agentfan.club>
