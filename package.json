{
  "name": "router",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.3.12"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@router/web",
    "dev:api": "turbo run dev --filter=@router/api",
    "build": "turbo run build",
    "deploy": "bun run deploy:api && bun run deploy:web",
    "deploy:api": "turbo run deploy --filter=@router/api",
    "deploy:web": "turbo run deploy --filter=@router/web",
    "typegen": "turbo run typegen",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.11.9",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.1"
  }
}
