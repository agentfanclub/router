{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": ["CLOUDFLARE_*", "WRANGLER_*"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", ".dev.vars*", "!src/routeTree.gen.ts"],
      "env": ["CLOUDFLARE_ENV", "VITE_*"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "typegen": {
      "cache": false
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
